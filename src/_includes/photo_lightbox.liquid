{%- comment -%}
  Shared photo lightbox. Include once per page, after any number of
  {% include photo_grid.liquid %} blocks. Each `.js-photo-grid` on the page
  acts as its own independent gallery; thumbnails also get a loading spinner
  cleared once their image is ready.
{%- endcomment -%}
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
  <button type="button" class="lb-close" aria-label="Close">&times;</button>
  <button type="button" class="lb-prev" aria-label="Previous photo">&#8249;</button>
  <span class="lb-spinner" aria-hidden="true"></span>
  <img alt="">
  <button type="button" class="lb-next" aria-label="Next photo">&#8250;</button>
  <span class="lb-count"></span>
</div>

<script>
  (function () {
    var box = document.getElementById('lightbox');
    var grids = Array.prototype.slice.call(document.querySelectorAll('.js-photo-grid'));
    if (!box || !grids.length) return;

    var img = box.querySelector('img');
    var count = box.querySelector('.lb-count');
    var urls = [];
    var current = 0;
    var lastFocus = null;

    function preload(i) {
      if (i < 0 || i >= urls.length) return;
      var p = new Image();
      p.src = urls[i];
    }

    function done() {
      box.classList.remove('is-loading');
    }
    img.addEventListener('load', done);
    img.addEventListener('error', done);

    function show(i) {
      current = (i + urls.length) % urls.length;
      box.classList.add('is-loading');
      img.alt = 'Photo ' + (current + 1) + ' of ' + urls.length;
      count.textContent = (current + 1) + ' / ' + urls.length;
      img.src = urls[current];
      if (img.complete) done();
      preload(current + 1);
      preload(current - 1);
    }

    function open(list, i) {
      urls = list;
      lastFocus = document.activeElement;
      box.hidden = false;
      void box.offsetWidth;
      box.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      show(i);
      box.querySelector('.lb-close').focus();
    }

    function close() {
      box.classList.remove('is-open');
      document.body.style.overflow = '';
      setTimeout(function () { box.hidden = true; }, 200);
      if (lastFocus) lastFocus.focus();
    }

    grids.forEach(function (grid) {
      var links = Array.prototype.slice.call(grid.querySelectorAll('a[data-full]'));
      var list = links.map(function (a) { return a.getAttribute('data-full'); });
      links.forEach(function (a, i) {
        var thumb = a.querySelector('img');
        if (thumb) {
          var reveal = function () { a.classList.add('is-loaded'); };
          if (thumb.complete && thumb.naturalWidth) reveal();
          else {
            thumb.addEventListener('load', reveal);
            thumb.addEventListener('error', reveal);
          }
        }
        a.addEventListener('click', function (e) {
          e.preventDefault();
          open(list, i);
        });
      });
    });

    box.querySelector('.lb-close').addEventListener('click', close);
    box.querySelector('.lb-prev').addEventListener('click', function () { show(current - 1); });
    box.querySelector('.lb-next').addEventListener('click', function () { show(current + 1); });
    box.addEventListener('click', function (e) {
      if (e.target === box) close();
    });

    document.addEventListener('keydown', function (e) {
      if (box.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowRight') show(current + 1);
      else if (e.key === 'ArrowLeft') show(current - 1);
    });

    var startX = null;
    box.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; }, { passive: true });
    box.addEventListener('touchend', function (e) {
      if (startX === null) return;
      var dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) show(current + (dx < 0 ? 1 : -1));
      startX = null;
    });
  })();
</script>
