<div id="map" class="full hide" style="height: {{ include.height }}"></div>

<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@5.24.0/dist/maplibre-gl.css" integrity="sha384-uTttxo/aOKbdE5RlD/SPzSDoDmNvGlUYPjONi2MN/b7c9HPSvW07OIuyP7uL6jxK" crossorigin="anonymous">
<script src="https://unpkg.com/maplibre-gl@5.24.0/dist/maplibre-gl.js" integrity="sha384-5+cfbwT0iiub6VsQAdn6yz16nr6sDiQoHx6tm4O8OVYXHYOxcffFmCJBL0dgdvGp" crossorigin="anonymous"></script>

<style>
#map {
  --popup-bg: #fefefe;
  --popup-text: #111;
  --popup-muted: #555;
  --popup-btn-border: #ccc;
  --popup-btn-bg: #fff;
}

@media (prefers-color-scheme: dark) {
  #map {
    --popup-bg: #1c1f24;
    --popup-text: #e6e6e6;
    --popup-muted: #9aa0a6;
    --popup-btn-border: #3a3f47;
    --popup-btn-bg: #14161a;
  }
}

.maplibregl-popup-content {
  border-radius: 0;
  background-color: var(--popup-bg);
  color: var(--popup-text);
  padding: 13px 10px 10px 10px;
  text-align: center;
}

.maplibregl-popup-content a {
  color: var(--popup-text);
}

/* The tip is a CSS-border triangle; MapLibre colours one side per anchor with
   `.maplibregl-popup-anchor-* .maplibregl-popup-tip` rules, so match that
   specificity to recolour it rather than the bare `.maplibregl-popup-tip`. */
.maplibregl-popup-anchor-top .maplibregl-popup-tip,
.maplibregl-popup-anchor-top-left .maplibregl-popup-tip,
.maplibregl-popup-anchor-top-right .maplibregl-popup-tip {
  border-bottom-color: var(--popup-bg);
}

.maplibregl-popup-anchor-bottom .maplibregl-popup-tip,
.maplibregl-popup-anchor-bottom-left .maplibregl-popup-tip,
.maplibregl-popup-anchor-bottom-right .maplibregl-popup-tip {
  border-top-color: var(--popup-bg);
}

.maplibregl-popup-anchor-left .maplibregl-popup-tip {
  border-right-color: var(--popup-bg);
}

.maplibregl-popup-anchor-right .maplibregl-popup-tip {
  border-left-color: var(--popup-bg);
}

.maplibregl-popup-content img {
  margin-bottom: 10px;
}

.popup-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-bottom: 10px;
  font: 12px/1 system-ui, sans-serif;
  color: var(--popup-muted);
}

.popup-nav button {
  width: 22px;
  height: 22px;
  padding: 0;
  border: 1px solid var(--popup-btn-border);
  border-radius: 4px;
  background: var(--popup-btn-bg);
  color: var(--popup-text);
  font-size: 14px;
  line-height: 1;
  cursor: pointer;
}

.popup-nav button:disabled {
  opacity: 0.35;
  cursor: default;
}
</style>

<script>
  window.addEventListener('DOMContentLoaded', () => {
    function capitalise(s) {
      return s[0].toUpperCase() + s.slice(1);
    }

    // MapLibre wants [lng, lat]; our journey data stores location as [lat, lon].
    const lngLat = ([lat, lon]) => [lon, lat];

    const toRad = (d) => d * Math.PI / 180;
    const toDeg = (r) => r * 180 / Math.PI;

    // Great-circle distance in km between two [lon, lat] points.
    function haversineKm(a, b) {
      const lat1 = toRad(a[1]), lat2 = toRad(b[1]);
      const dLat = lat2 - lat1, dLon = toRad(b[0] - a[0]);
      const h = Math.sin(dLat / 2) ** 2 + Math.cos(lat1) * Math.cos(lat2) * Math.sin(dLon / 2) ** 2;
      return 2 * 6371 * Math.asin(Math.min(1, Math.sqrt(h)));
    }

    // Points along the great circle between two [lon, lat] points, so long legs
    // curve like real travel instead of cutting straight chords across Mercator.
    function greatCircle(a, b, segments) {
      const lon1 = toRad(a[0]), lat1 = toRad(a[1]);
      const lon2 = toRad(b[0]), lat2 = toRad(b[1]);
      const d = 2 * Math.asin(Math.min(1, Math.sqrt(
        Math.sin((lat2 - lat1) / 2) ** 2 +
        Math.cos(lat1) * Math.cos(lat2) * Math.sin((lon2 - lon1) / 2) ** 2
      )));
      if (!d) return [a.slice(), b.slice()];
      const pts = [];
      for (let i = 0; i <= segments; i++) {
        const f = i / segments;
        const A = Math.sin((1 - f) * d) / Math.sin(d);
        const B = Math.sin(f * d) / Math.sin(d);
        const x = A * Math.cos(lat1) * Math.cos(lon1) + B * Math.cos(lat2) * Math.cos(lon2);
        const y = A * Math.cos(lat1) * Math.sin(lon1) + B * Math.cos(lat2) * Math.sin(lon2);
        const z = A * Math.sin(lat1) + B * Math.sin(lat2);
        pts.push([toDeg(Math.atan2(y, x)), toDeg(Math.atan2(z, Math.hypot(x, y)))]);
      }
      return pts;
    }

    // One continuous great-circle arc through a list of [lon, lat] points, with
    // longitudes unwrapped so legs crossing the antimeridian don't streak across.
    function arcThrough(coords) {
      const line = [];
      for (let i = 0; i < coords.length - 1; i++) {
        const km = haversineKm(coords[i], coords[i + 1]);
        const seg = greatCircle(coords[i], coords[i + 1], Math.max(6, Math.min(128, Math.round(km / 40))));
        line.push(...(i === 0 ? seg : seg.slice(1)));
      }
      const out = line.map((c) => c.slice());
      for (let i = 1; i < out.length; i++) {
        while (out[i][0] - out[i - 1][0] > 180) out[i][0] -= 360;
        while (out[i][0] - out[i - 1][0] < -180) out[i][0] += 360;
      }
      return out;
    }

    // Does the segment a -> b overlap the axis-aligned box at all? (Liang-Barsky.)
    function segHitsBox(a, b, minX, minY, maxX, maxY) {
      let t0 = 0, t1 = 1;
      const dx = b[0] - a[0], dy = b[1] - a[1];
      const edges = [[-dx, a[0] - minX], [dx, maxX - a[0]], [-dy, a[1] - minY], [dy, maxY - a[1]]];
      for (const [p, q] of edges) {
        if (p === 0) {
          if (q < 0) return false;
        } else {
          const r = q / p;
          if (p < 0) { if (r > t1) return false; if (r > t0) t0 = r; }
          else { if (r < t0) return false; if (r < t1) t1 = r; }
        }
      }
      return true;
    }

    const PIN_SIZE = 24;

    function pinIcon(colour) {
      const fill = colour != undefined ? colour : 'red';
      const svg = `<svg style="fill: ${fill}" width="${PIN_SIZE}" height="${PIN_SIZE}" xmlns="http://www.w3.org/2000/svg"><path fill="none" d="M0 0h24v24H0z"/><path d="M19 9A7 7 0 1 0 5 9c0 1.387.41 2.677 1.105 3.765h-.008C8.457 16.46 12 22 12 22l5.903-9.235h-.007A6.98 6.98 0 0 0 19 9zm-7 3a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/></svg>`;
      return 'data:image/svg+xml;base64,' + btoa(svg);
    }

    // A small right-pointing chevron; symbol layers rotate it to follow the route.
    function arrowIcon(colour) {
      const svg = `<svg width="16" height="16" xmlns="http://www.w3.org/2000/svg"><path fill="${colour}" d="M4 1l9 7-9 7 3-7z"/></svg>`;
      return 'data:image/svg+xml;base64,' + btoa(svg);
    }

    // Colour for a point in the trip: 0 = start (green) -> 0.5 (amber) -> 1 = end (red).
    function journeyColour(f) {
      const stops = [[0, [26, 152, 80]], [0.5, [253, 174, 97]], [1, [215, 48, 39]]];
      f = Math.max(0, Math.min(1, f));
      let a = stops[0], b = stops[stops.length - 1];
      for (let i = 0; i < stops.length - 1; i++) {
        if (f >= stops[i][0] && f <= stops[i + 1][0]) { a = stops[i]; b = stops[i + 1]; break; }
      }
      const t = b[0] === a[0] ? 0 : (f - a[0]) / (b[0] - a[0]);
      const c = a[1].map((v, k) => Math.round(v + (b[1][k] - v) * t));
      return `rgb(${c[0]}, ${c[1]}, ${c[2]})`;
    }

    // Match the map tiles and marker colours to the OS colour scheme. MapLibre
    // needs the style picked up front, so a later OS theme change only takes
    // effect on reload.
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const jawgStyle = prefersDark ? 'jawg-dark' : 'jawg-sunny';

    // Set up the map and allow for controlling interactivity such as zoom, scroll etc
    const map = new maplibregl.Map({
      container: 'map',
      style: `https://api.jawg.io/styles/${jawgStyle}.json?access-token=L72TIZSbpN96TpWalLwyaqI1hy1zmrVukmXtLocvpVUN8EWBNqHfI9rTHLAGNE07`,
      center: [0, 20],
      zoom: 1,
      attributionControl: { compact: true },
      dragRotate: false,
      pitchWithRotate: false,
      scrollZoom: {{ include.zoom | default: true }},
      doubleClickZoom: {{ include.zoom | default: true }},
      touchZoomRotate: {{ include.zoom | default: true }},
      boxZoom: {{ include.zoom | default: true }},
      dragPan: {{ include.drag | default: true }}
    });

    if ({{ include.zoom | default: true }}) {
      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-left');
    }

    // Load all the data for our journey
    const journey = {{ site.data.journey | jsonify }};

    // If requested filter to the given step
    const step = '{{ include.step }}';
    const steps = step ? journey.filter(s => s.id === step) : journey;

    // Determine what data we are plotting
    const mode = '{{ include.mode }}' ? '{{ include.mode }}' : 'steps';
    const points = mode === 'photos' ? steps.flatMap(step => step.photos.map(p => {
      if (p.location[0] == 0 || p.location[1] == 0) {
        console.warn('Defaulting missing location of photo to use step location');
        p.location = step.location;
      }

      return p;
    })) : steps;
    console.info(`Plotting ${points.length} ${mode}`);

    // Extract the locations to plot
    const locations = points.map(s => s.location);
    const routeCoords = locations.map(lngLat);

    // Smooth great-circle arc through every step; also drives the zoomed-out
    // "wandering" line below.
    const routeArc = mode === 'steps' && routeCoords.length > 1 ? arcThrough(routeCoords) : [];

    // Fit the map to show the whole trip. For steps we fit to the arc itself so
    // the full route (curve and all) is in view from the start; the optional
    // `trim` still applies to the plainer point-only fit.
    const trim = parseInt('{% if include.trim %}{{ include.trim }}{% else %}0{% endif %}');
    const fitCoords = routeArc.length
      ? routeArc
      : (trim ? routeCoords.slice(trim, -trim) : routeCoords);
    const maxZoom = mode === 'photos' ? 15 : 10;

    if (fitCoords.length === 1) {
      map.jumpTo({ center: fitCoords[0], zoom: maxZoom });
    } else if (fitCoords.length > 1) {
      const bounds = new maplibregl.LngLatBounds();
      for (const c of fitCoords) {
        bounds.extend(c);
      }
      map.fitBounds(bounds, { maxZoom: maxZoom, padding: 30, animate: false });
    }

    const width = 500;
    const height = 500;

    // Build the popup markup for a single point
    function popupHtml(point) {
      if (mode === 'photos') {
        const url = `${point.url}?tr=w-${width},h-${height},fo-center`;
        return `<img src="${url}" height="auto" width="100%" style="min-width: 200px; object-fit: cover;">`;
      }

      const hasImage = point.photos.length > 0;
      const url = hasImage ? `${point.photos[0].url}?tr=w-${width},h-${height},fo-center` : '';
      const image = hasImage ? `<a href="/journey/${point['key']}"><img src="${url}" height="auto" width="100%" style="min-width: 200px; object-fit: cover;"></a>` : '';
      const date = new Date(point.arrived * 1000).toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: '2-digit' });

      return `${image}<div style="font-family: Chalkduster, fantasy; font-size: 16px;"><b><a href="/journey/${point['key']}">${point.name}</a></b></div><div style="font-family: Chalkduster, fantasy; font-size: 14px; letter-spacing: 2px; margin-top: 10px">${date}</div>`;
    }

    // Turn the points into GeoJSON features, merging any that sit on the same
    // spot (~100m) into one marker - e.g. the departure and the return home are
    // the same place. Each marker keeps the list of its steps' popups so they
    // can be paged through; `gi` indexes that list, `order` is the marker's most
    // recent step so the collision sort still favours recent visits.
    const markerKey = (c) => `${Math.round(c[0] * 1000)},${Math.round(c[1] * 1000)}`;
    const groups = new Map();
    let seq = 0;
    for (const point of points) {
      if (point['state'] === 'stopped') {
        continue;
      }
      const coord = lngLat(point.location);
      const key = markerKey(coord);
      let g = groups.get(key);
      if (!g) {
        g = { coord, htmls: [] };
        groups.set(key, g);
      }
      g.htmls.push(popupHtml(point));
      g.order = seq++;
    }

    const markerPopups = [];
    const features = [];
    for (const g of groups.values()) {
      features.push({
        type: 'Feature',
        geometry: { type: 'Point', coordinates: g.coord },
        properties: { gi: markerPopups.length, count: g.htmls.length, order: g.order }
      });
      markerPopups.push(g.htmls);
    }

    map.on('load', () => {
      // Register the pin marker as a map image so it can be used by a symbol layer
      const pin = new Image(PIN_SIZE, PIN_SIZE);
      pin.onload = () => {
        if (!map.hasImage('pin')) {
          map.addImage('pin', pin);
        }
      };
      pin.src = pinIcon('#7C3AED');

      const arrow = new Image(16, 16);
      arrow.onload = () => {
        if (!map.hasImage('arrow')) {
          map.addImage('arrow', arrow);
        }
      };
      arrow.src = arrowIcon(prefersDark ? '#cbd0d6' : '#333333');

      // Draw the route as two line layers: a faint "wandering" line through every
      // step, and a bold "trunk" through only the big hops so the shape of the
      // trip reads at a glance. Each leg is its own feature carrying `t` (0 at the
      // start of the trip, 1 at the end) so the green -> amber -> red colour
      // advances one step at a time rather than by raw distance. Arrowheads show
      // direction of travel; the trunk hands off to the wandering line as you
      // zoom in so long-hop chords don't cut across a street-level view.
      if (mode === 'steps' && routeCoords.length > 1) {
        const lastStep = routeCoords.length - 1;
        const ZOOM_TIGHTEN = 4.5;

        const colourByStep = [
          'interpolate', ['linear'], ['get', 't'],
          0, journeyColour(0),
          0.5, journeyColour(0.5),
          1, journeyColour(1)
        ];

        // A single LineString feature for the leg a -> b, coloured by its position
        // in the trip (t). `densify` follows the great circle; otherwise straight.
        function makeLeg(a, b, t, densify) {
          const line = densify
            ? greatCircle(a, b, Math.max(6, Math.min(128, Math.round(haversineKm(a, b) / 40))))
            : [a.slice(), b.slice()];
          for (let j = 1; j < line.length; j++) {
            while (line[j][0] - line[j - 1][0] > 180) line[j][0] -= 360;
            while (line[j][0] - line[j - 1][0] < -180) line[j][0] += 360;
          }
          return { type: 'Feature', properties: { t }, geometry: { type: 'LineString', coordinates: line } };
        }

        // Round a coord to ~1km so revisits to the same place share a key.
        const legKey = (a, b) => {
          const r = (v) => Math.round(v * 100);
          return [`${r(a[0])},${r(a[1])}`, `${r(b[0])},${r(b[1])}`].sort().join('|');
        };

        // Legs between consecutive entries of `indices` (used for the full route
        // and the trunk), de-duplicated so a corridor travelled more than once -
        // e.g. out and back - draws a single line, not a stack of near-parallel
        // ones.
        function legFeatures(indices, densify) {
          const seen = new Set();
          const features = [];
          for (let k = 0; k < indices.length - 1; k++) {
            const a = routeCoords[indices[k]], b = routeCoords[indices[k + 1]];
            const key = legKey(a, b);
            if (seen.has(key)) continue;
            seen.add(key);
            features.push(makeLeg(a, b, indices[k] / lastStep, densify));
          }
          return { type: 'FeatureCollection', features };
        }

        const nodeKey = (c) => `${Math.round(c[0] * 100)},${Math.round(c[1] * 100)}`;

        // Legs to draw when zoomed in. A leg is a candidate if it crosses the
        // (padded) viewport at all - so the route never breaks just because no
        // pin happens to be on screen. Candidates are added shortest-first;
        // duplicates (out-and-back / revisits) are dropped, and a long leg
        // anchored to an on-screen pin is only kept if that's the pin's first
        // link - so a hub city draws a few spokes instead of a sunburst, but no
        // visible pin is ever left orphaned. The long inter-city hops are the
        // trunk's job and it fades back in as you zoom out.
        function localLegs(view) {
          const w = view.getWest(), e = view.getEast(), s = view.getSouth(), n = view.getNorth();
          const px = (e - w) * 0.3, py = (n - s) * 0.3;
          const bx0 = w - px, by0 = s - py, bx1 = e + px, by1 = n + py;
          const onScreen = (c) => c[0] >= w && c[0] <= e && c[1] >= s && c[1] <= n;
          const maxLegKm = haversineKm([w, s], [e, n]) * 1.5;

          const cands = [];
          for (let i = 0; i < lastStep; i++) {
            const a = routeCoords[i], b = routeCoords[i + 1];
            if (segHitsBox(a, b, bx0, by0, bx1, by1)) {
              cands.push({ i, a, b, km: haversineKm(a, b) });
            }
          }
          cands.sort((x, y) => x.km - y.km);

          const seen = new Set();
          const degree = new Map();
          const features = [];
          for (const { i, a, b, km } of cands) {
            const key = legKey(a, b);
            if (seen.has(key)) continue;
            const aOn = onScreen(a), bOn = onScreen(b);
            if (km > maxLegKm && (aOn || bOn)) {
              const firstLink = (aOn && !degree.get(nodeKey(a))) || (bOn && !degree.get(nodeKey(b)));
              if (!firstLink) continue;
            }
            seen.add(key);
            features.push(makeLeg(a, b, i / lastStep, false));
            if (aOn) degree.set(nodeKey(a), (degree.get(nodeKey(a)) || 0) + 1);
            if (bOn) degree.set(nodeKey(b), (degree.get(nodeKey(b)) || 0) + 1);
          }
          return { type: 'FeatureCollection', features };
        }

        const allSteps = routeCoords.map((_, i) => i);

        // Trunk: keep a step only when it's a long way from the last kept one, so
        // local pottering around a city collapses to a single node.
        const TRUNK_MIN_KM = 200;
        const trunkIdx = [];
        routeCoords.forEach((c, i) => {
          const lastI = trunkIdx[trunkIdx.length - 1];
          if (lastI === undefined || i === lastStep || haversineKm(routeCoords[lastI], c) >= TRUNK_MIN_KM) {
            trunkIdx.push(i);
          }
        });

        map.addSource('route', { type: 'geojson', data: legFeatures(allSteps, true) });
        map.addLayer({
          id: 'route',
          type: 'line',
          source: 'route',
          layout: { 'line-cap': 'round', 'line-join': 'round' },
          paint: {
            'line-color': colourByStep,
            // Faint background hint when zoomed out (the trunk carries the story
            // there); becomes the primary marker-to-marker connector once zoomed in.
            'line-width': ['interpolate', ['linear'], ['zoom'], 4.4, 1, 4.7, 2],
            'line-opacity': ['interpolate', ['linear'], ['zoom'], 4.4, 0.35, 4.7, 0.95]
          }
        });
        map.addLayer({
          id: 'route-arrows',
          type: 'symbol',
          source: 'route',
          layout: {
            'symbol-placement': 'line',
            'symbol-spacing': 150,
            'icon-image': 'arrow',
            'icon-size': 0.7,
            'icon-allow-overlap': true,
            'icon-ignore-placement': true
          },
          paint: { 'icon-opacity': ['interpolate', ['linear'], ['zoom'], 4.4, 0, 4.7, 0.9] }
        });

        // As you zoom in, redraw the wandering line through just the steps on
        // screen (plus one either side) so it tightens around the markers in
        // view; when zoomed out it snaps back to the full arc.
        let routeMode = null;
        function syncRouteDetail() {
          const overview = map.getZoom() < ZOOM_TIGHTEN;
          if (overview && routeMode === 'overview') return;
          routeMode = overview ? 'overview' : 'local';

          map.getSource('route').setData(
            overview ? legFeatures(allSteps, true) : localLegs(map.getBounds())
          );
        }
        map.on('moveend', syncRouteDetail);
        syncRouteDetail();

        if (trunkIdx.length > 1) {
          map.addSource('trunk', { type: 'geojson', data: legFeatures(trunkIdx, true) });
          map.addLayer({
            id: 'trunk',
            type: 'line',
            source: 'trunk',
            layout: { 'line-cap': 'round', 'line-join': 'round' },
            paint: {
              'line-color': colourByStep,
              'line-width': ['interpolate', ['linear'], ['zoom'], 1, 2, 8, 3.5],
              'line-opacity': ['interpolate', ['linear'], ['zoom'], 4.4, 1, 4.7, 0]
            }
          });
          map.addLayer({
            id: 'trunk-arrows',
            type: 'symbol',
            source: 'trunk',
            layout: {
              'symbol-placement': 'line',
              'symbol-spacing': 150,
              'icon-image': 'arrow',
              'icon-size': 0.75,
              'icon-allow-overlap': true,
              'icon-ignore-placement': true
            },
            paint: { 'icon-opacity': ['interpolate', ['linear'], ['zoom'], 4.4, 0.85, 4.7, 0] }
          });
        }
      }

      map.addSource('journey', {
        type: 'geojson',
        data: { type: 'FeatureCollection', features: features }
      });

      map.addLayer({
        id: 'points',
        type: 'symbol',
        source: 'journey',
        layout: {
          'icon-image': 'pin',
          'icon-anchor': 'bottom',
          // Let MapLibre's collision detection thin out overlapping pins; as you
          // zoom in and they spread apart, the hidden ones reappear. The most
          // recent step wins placement where several pile up.
          'icon-allow-overlap': false,
          'icon-padding': 2,
          'symbol-sort-key': ['-', 0, ['get', 'order']]
        }
      });

      // A small badge on markers that hold more than one step.
      map.addLayer({
        id: 'point-count',
        type: 'symbol',
        source: 'journey',
        filter: ['>', ['get', 'count'], 1],
        layout: {
          'text-field': ['to-string', ['get', 'count']],
          'text-font': ['Open Sans Bold', 'Noto Bold'],
          'text-size': 10,
          'text-offset': [0.55, -1.35],
          'text-allow-overlap': true,
          'text-ignore-placement': true
        },
        paint: {
          'text-color': '#fefefe',
          'text-halo-color': '#7C3AED',
          'text-halo-width': 2
        }
      });

      // Open a popup for the clicked marker; page through its steps if it holds
      // more than one (a place visited on separate occasions).
      map.on('click', 'points', (e) => {
        const htmls = markerPopups[e.features[0].properties.gi];
        const popup = new maplibregl.Popup({ closeButton: false, maxWidth: '250px', offset: PIN_SIZE })
          .setLngLat(e.features[0].geometry.coordinates)
          .setHTML(htmls[0])
          .addTo(map);
        if (htmls.length < 2) return;

        let idx = 0;
        const render = () => {
          popup.setHTML(
            `<div class="popup-nav">` +
              `<button type="button" data-step="-1"${idx === 0 ? ' disabled' : ''}>&#8249;</button>` +
              `<span>${idx + 1} / ${htmls.length}</span>` +
              `<button type="button" data-step="1"${idx === htmls.length - 1 ? ' disabled' : ''}>&#8250;</button>` +
            `</div>` + htmls[idx]
          );
          popup.getElement().querySelectorAll('.popup-nav button').forEach((btn) => {
            btn.addEventListener('click', (ev) => {
              ev.stopPropagation();
              idx = Math.min(htmls.length - 1, Math.max(0, idx + Number(btn.dataset.step)));
              render();
            });
          });
        };
        render();
      });

      for (const evt of ['mouseenter', 'mouseleave']) {
        map.on(evt, 'points', () => {
          map.getCanvas().style.cursor = evt === 'mouseenter' ? 'pointer' : '';
        });
      }

      // Show the map now it's all configured
      map.getContainer().classList.remove('hide');
    });

    // Safety net: never leave the map invisible if 'load' is delayed or missed
    // (e.g. a backgrounded tab throttling requestAnimationFrame).
    setTimeout(() => map.getContainer().classList.remove('hide'), 4000);
  });
</script>
